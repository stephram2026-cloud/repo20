+import { replayChangesAsOneSync, snapshotDatabase } from '#mocks/sync-replay';
+import * as db from '#server/db';
+import { runHandler } from '#server/mutators';
+import * as sheet from '#server/sheet';
+import * as monthUtils from '#shared/months';
+
+import { app } from './app';
+import { createAllBudgets } from './base';
+
+// Runs random sequences of budget actions and checks the budget against an
+// independent ledger after every one of them.
+//
+// The ledger is told what each action is meant to do (move 20.00 from A to
+// B, hold 50.00, merge A into B ...) and works every month out from the
+// envelope rules alone. Comparing the budget with its own from-scratch
+// recalculation can't replace this: both follow the same code, so they agree
+// just as well when money is allocated to the wrong place. On top of the
+// ledger, every month has to account for the money actually in the on-budget
+// accounts: To Budget + held + category balances = cash.
+//
+// A category is income or an expense by its own setting, wherever it is
+// filed: the API or an import can leave an expense category in the income
+// group, and what is spent in it is still spending, not negative income.
+
+const handlers = app.handlers;
+
+const FIRST_MONTHS = ['2016-10', '2016-11', '2016-12', '2017-01'];
+const ACTION_MONTHS = [...FIRST_MONTHS, '2017-02', '2017-03'];
+const SEEDS = Number(process.env.LEDGER_SEEDS || 40);
+const STEPS = 12;
+
+type Transaction = {
+  id: string;
+  month: string;
+  amount: number;
+  category: string;
+  account: string;
+};
+
+type MonthFigures = {
+  toBudget: number;
+  held: number;
+  budgeted: number;
+  spent: number;
+  income: number;
+  balances: Map<string, number>;
+};
+
+type Ledger = {
+  months: string[];
+  expense: Set<string>;
+  income: Set<string>;
+  onBudget: Map<string, boolean>;
+  transactions: Transaction[];
+  // `${month}|${category}` to an amount or a flag
+  budgeted: Map<string, number>;
+  autoHold: Map<string, boolean>;
+  // Rolling over overspending is turned on or off from a month on
+  rollover: Map<string, Array<[string, boolean]>>;
+  held: Map<string, number>;
+};
+
+function createLedger(): Ledger {
+  return {
+    months: [],
+    expense: new Set(),
+    income: new Set(),
+    onBudget: new Map(),
+    transactions: [],
+    budgeted: new Map(),
+    autoHold: new Map(),
+    rollover: new Map(),
+    held: new Map(),
+  };
+}
+
+function getBudgeted(ledger: Ledger, month: string, category: string) {
+  return ledger.budgeted.get(`${month}|${category}`) ?? 0;
+}
+
+function addBudgeted(
+  ledger: Ledger,
+  month: string,
+  category: string,
+  amount: number,
+) {
+  ledger.budgeted.set(
+    `${month}|${category}`,
+    getBudgeted(ledger, month, category) + amount,
+  );
+}
+
+function getActivity(ledger: Ledger, month: string, category: string) {
+  return ledger.transactions
+    .filter(
+      t =>
+        t.month === month &&
+        t.category === category &&
+        ledger.onBudget.get(t.account),
+    )
+    .reduce((total, t) => total + t.amount, 0);
+}
+
+function rollsOver(ledger: Ledger, month: string, category: string) {
+  let isOn = false;
+  for (const [start, flag] of ledger.rollover.get(category) ?? []) {
+    if (month >= start) {
+      isOn = flag;
+    }
+  }
+  return isOn;
+}
+
+// The envelope rules: what is not budgeted or held rolls into next month's
+// To Budget together with what was held; a category keeps its balance, except
+// that overspending comes out of next month's To Budget and the category
+// starts again from zero unless it rolls its overspending over.
+function computeMonths(ledger: Ledger): Map<string, MonthFigures> {
+  const figures = new Map<string, MonthFigures>();
+  const carried = new Map<string, number>();
+  let fromLastMonth = 0;
+  let overspentLastMonth = 0;
+
+  for (const month of ledger.months) {
+    const balances = new Map<string, number>();
+    let budgeted = 0;
+    let spent = 0;
+    let overspent = 0;
+
+    for (const category of ledger.expense) {
+      const activity = getActivity(ledger, month, category);
+      const balance =
+        (carried.get(category) ?? 0) +
+        getBudgeted(ledger, month, category) +
+        activity;
+      budgeted += getBudgeted(ledger, month, category);
+      spent += activity;
+      balances.set(category, balance);
+
+      if (balance < 0 && !rollsOver(ledger, month, category)) {
+        overspent += balance;
+        carried.set(category, 0);
+      } else {
+        carried.set(category, balance);
+      }
+    }
+
+    let income = 0;
+    let heldAutomatically = 0;
+    for (const category of ledger.income) {
+      const activity = getActivity(ledger, month, category);
+      income += activity;
+      if (ledger.autoHold.get(`${month}|${category}`)) {
+        heldAutomatically += activity;
+      }
+    }
+
+    const heldByHand = ledger.held.get(month) ?? 0;
+    const held = heldByHand !== 0 ? heldByHand : heldAutomatically;
+    const toBudget =
+      fromLastMonth + income + overspentLastMonth - budgeted - held;
+
+    figures.set(month, { toBudget, held, budgeted, spent, income, balances });
+    fromLastMonth = toBudget + held;
+    overspentLastMonth = overspent;
+  }
+
+  return figures;
+}
+
+function createRandom(seed: number) {
+  let state = seed >>> 0;
+  const next = () => {
+    state = (state * 1664525 + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+  return {
+    next,
+    upTo: (max: number) => Math.floor(next() * max),
+    pick: <T>(items: T[]): T => items[Math.floor(next() * items.length)],
+  };
+}
+
+async function setUpBudget(ledger: Ledger) {
+  await sheet.loadSpreadsheet(db);
+
+  await db.insertCategoryGroup({ id: 'income', name: 'Income', is_income: 1 });
+  for (const id of ['salary', 'sales']) {
+    await db.insertCategory({
+      id,
+      name: id,
+      cat_group: 'income',
+      is_income: 1,
+    });
+    ledger.income.add(id);
+  }
+
+  for (const [group, categories] of [
+    ['home', ['food', 'rent', 'fun']],
+    ['work', ['stock', 'tools']],
+    ['other', ['fees', 'gifts']],
+  ] as const) {
+    await db.insertCategoryGroup({ id: group, name: group });
+    for (const id of categories) {
+      await db.insertCategory({ id, name: id, cat_group: group });
+      ledger.expense.add(id);
+    }
+  }
+
+  for (const [id, offbudget] of [
+    ['checking', 0],
+    ['business', 0],
+    ['investments', 1],
+  ] as const) {
+    await db.insertAccount({ id, name: id, offbudget });
+    ledger.onBudget.set(id, offbudget === 0);
+  }
+
+  for (const month of FIRST_MONTHS) {
+    for (const [amount, category, account] of [
+      [500000, 'salary', 'checking'],
+      [200000, 'sales', 'business'],
+      [-40000, 'food', 'checking'],
+      [-100000, 'rent', 'checking'],
+      [-7000, 'fun', 'checking'],
+      [-60000, 'stock', 'business'],
+      [-9000, 'tools', 'business'],
+      [-1500, 'fees', 'checking'],
+      [-2500, 'gifts', 'investments'],
+    ] as const) {
+      await addTransaction(ledger, month, amount, category, account);
+    }
+  }
+
+  await createAllBudgets();
+  ledger.months = getCreatedMonths();
+
+  for (const month of FIRST_MONTHS) {
+    for (const [category, amount] of [
+      ['food', 35000],
+      ['rent', 100000],
+      ['fun', 10000],
+      ['stock', 50000],
+      ['tools', 12000],
+      ['fees', 1000],
+      ['gifts', 3000],
+    ] as const) {
+      await runHandler(handlers['budget/budget-amount'], {
+        month,
+        category,
+        amount,
+      });
+      addBudgeted(ledger, month, category, amount);
+    }
+  }
+}
+
+function getCreatedMonths() {
+  return [...sheet.get().meta().createdMonths].sort();
+}
+
+async function addTransaction(
+  ledger: Ledger,
+  month: string,
+  amount: number,
+  category: string,
+  account: string,
+) {
+  const id = `transaction-${ledger.transactions.length}`;
+  await db.insertTransaction({
+    id,
+    date: `${month}-15`,
+    amount,
+    category,
+    account,
+  });
+  ledger.transactions.push({ id, month, amount, category, account });
+}
+
+function readCell(month: string, name: string) {
+  const cell = sheet.getCellValue(monthUtils.sheetForMonth(month), name);
+  return typeof cell === 'number' ? cell : 0;
+}
+
+// Every way the budget disagrees with the ledger, or with the money in the
+// on-budget accounts
+async function findDiscrepancies(ledger: Ledger): Promise<string[]> {
+  await sheet.waitOnSpreadsheet();
+  const expected = computeMonths(ledger);
+  const discrepancies: string[] = [];
+
+  for (const month of ledger.months) {
+    const figures = expected.get(month);
+    if (!figures) {
+      continue;
+    }
+
+    const check = (label: string, actual: number, shouldBe: number) => {
+      if (actual !== shouldBe) {
+        discrepancies.push(
+          `${month} ${label}: ${actual}, should be ${shouldBe}`,
+        );
+      }
+    };
+
+    check('To Budget', readCell(month, 'to-budget'), figures.toBudget);
+    check('held', readCell(month, 'buffered-selected'), figures.held);
+    check('budgeted', -readCell(month, 'total-budgeted'), figures.budgeted);
+    check('spent', readCell(month, 'total-spent'), figures.spent);
+    check('income', readCell(month, 'total-income'), figures.income);
+
+    let balanceTotal = 0;
+    for (const [category, balance] of figures.balances) {
+      check(
+        `${category} balance`,
+        readCell(month, `leftover-${category}`),
+        balance,
+      );
+      balanceTotal += balance;
+    }
+    check('balance', readCell(month, 'total-leftover'), balanceTotal);
+
+    const { end } = monthUtils.bounds(month);
+    const cash = await db.first<{ amount: number | null }>(
+      `SELECT SUM(t.amount) AS amount FROM transactions t
+         JOIN accounts a ON a.id = t.acct
+        WHERE t.tombstone = 0 AND a.offbudget = 0 AND t.date <= ?`,
+      [end],
+    );
+    check(
+      'To Budget + held + balances against cash',
+      readCell(month, 'to-budget') +
+        readCell(month, 'buffered-selected') +
+        readCell(month, 'total-leftover'),
+      cash?.amount ?? 0,
+    );
+  }
+
+  return discrepancies;
+}
+
+// Merging adds what was budgeted for the merged categories to the remaining
+// one, exactly as it was entered, and moves their transactions to it. The
+// ledger then works the remaining category out like any other, so nothing
+// about the result is taken from the budget itself.
+async function mergeCategories(
+  ledger: Ledger,
+  merged: string[],
+  into: string,
+  merge: () => Promise<unknown>,
+): Promise<string[]> {
+  await merge();
+
+  const discrepancies: string[] = [];
+  for (const month of ledger.months) {
+    const entered = [...merged, into].reduce(
+      (total, category) => total + getBudgeted(ledger, month, category),
+      0,
+    );
+    ledger.budgeted.set(`${month}|${into}`, entered);
+
+    const row = await db.first<{ amount: number | null }>(
+      'SELECT amount FROM zero_budgets WHERE month = ? AND category = ?',
+      [parseInt(month.replace('-', '')), into],
+    );
+    if ((row?.amount ?? 0) !== entered) {
+      discrepancies.push(
+        `${month} ${into} budgeted after merging ${merged.join(', ')}: ` +
+          `${row?.amount ?? 0}, when ${entered} was entered`,
+      );
+    }
+  }
+  for (const transaction of ledger.transactions) {
+    if (merged.includes(transaction.category)) {
+      transaction.category = into;
+    }
+  }
+  merged.forEach(category => {
+    ledger.expense.delete(category);
+    ledger.income.delete(category);
+  });
+
+  return discrepancies;
+}
+
+async function runAction(
+  ledger: Ledger,
+  random: ReturnType<typeof createRandom>,
+): Promise<{ description: string; discrepancies: string[] }> {
+  const expense = [...ledger.expense];
+  const month =
+    random.next() < 0.15
+      ? random.pick(ledger.months.slice(-4))
+      : random.pick(ACTION_MONTHS);
+  const figures = computeMonths(ledger).get(month);
+  if (!figures) {
+    throw new Error(`No figures for ${month}`);
+  }
+  const balance = (category: string) => figures.balances.get(category) ?? 0;
+  const category = random.pick(expense);
+  const other = random.pick(expense.filter(id => id !== category));
+  const currencyCode = 'USD';
+  let discrepancies: string[] = [];
+  let description: string;
+
+  switch (random.upTo(21)) {
+    case 0: {
+      const amount = random.upTo(60000);
+      description = `budget ${amount} for ${category} in ${month}`;
+      await runHandler(handlers['budget/budget-amount'], {
+        month,
+        category,
+        amount,
+      });
+      ledger.budgeted.set(`${month}|${category}`, amount);
+      break;
+    }
+    case 1: {
+      const amount = 1 + random.upTo(9000);
+      description = `move ${amount} from ${category} to ${other} in ${month}`;
+      await runHandler(handlers['budget/transfer-category'], {
+        month,
+        amount,
+        from: category,
+        to: other,
+        currencyCode,
+      });
+      addBudgeted(ledger, month, category, -amount);
+      addBudgeted(ledger, month, other, amount);
+      break;
+    }
+    case 2: {
+      const amount = 1 + random.upTo(9000);
+      description = `move ${amount} from ${category} to To Budget in ${month}`;
+      await runHandler(handlers['budget/transfer-category'], {
+        month,
+        amount,
+        from: category,
+        to: 'to-budget',
+        currencyCode,
+      });
+      addBudgeted(ledger, month, category, -amount);
+      break;
+    }
+    case 3: {
+      description = `cover ${category} from ${other} in ${month}`;
+      await runHandler(handlers['budget/cover-overspending'], {
+        month,
+        to: category,
+        from: other,
+        currencyCode,
+      });
+      // As much of the overspending as the other category has
+      if (balance(category) < 0 && balance(other) > 0) {
+        const amount = Math.min(-balance(category), balance(other));
+        addBudgeted(ledger, month, other, -amount);
+        addBudgeted(ledger, month, category, amount);
+      }
+      break;
+    }
+    case 4: {
+      description = `cover ${category} from To Budget in ${month}`;
+      await runHandler(handlers['budget/cover-overspending'], {
+        month,
+        to: category,
+        from: 'to-budget',
+        currencyCode,
+      });
+      if (balance(category) < 0 && figures.toBudget > 0) {
+        addBudgeted(
+          ledger,
+          month,
+          category,
+          Math.min(-balance(category), figures.toBudget),
+        );
+      }
+      break;
+    }
+    case 5:
+    case 6: {
+      const amount = 1 + random.upTo(400000);
+      description = `hold ${amount} in ${month}`;
+      await runHandler(handlers['budget/hold-for-next-month'], {
+        month,
+        amount,
+      });
+      // That much more is held, as far as there is anything left to budget
+      if (figures.toBudget > 0) {
+        ledger.held.set(
+          month,
+          figures.held + Math.min(amount, figures.toBudget),
+        );
+      }
+      break;
+    }
+    case 7: {
+      description = `stop holding in ${month}`;
+      await runHandler(handlers['budget/reset-hold'], { month });
+      ledger.held.set(month, 0);
+      break;
+    }
+    case 8: {
+      const amount = 1 + random.upTo(50000);
+      description = `move ${amount} from To Budget to ${category} in ${month}`;
+      await runHandler(handlers['budget/transfer-available'], {
+        month,
+        amount,
+        category,
+      });
+      addBudgeted(
+        ledger,
+        month,
+        category,
+        Math.max(Math.min(amount, figures.toBudget), 0),
+      );
+      break;
+    }
+    case 9: {
+      const flag = random.next() < 0.6;
+      description = `roll over overspending of ${category} from ${month}: ${flag}`;
+      await runHandler(handlers['budget/set-carryover'], {
+        startMonth: month,
+        category,
+        flag,
+      });
+      ledger.rollover.set(category, [
+        ...(ledger.rollover.get(category) ?? []),
+        [month, flag],
+      ]);
+      break;
+    }
+    case 10: {
+      const incomeCategory = random.pick([...ledger.income]);
+      const flag = random.next() < 0.7;
+      description = `hold ${incomeCategory} automatically from ${month}: ${flag}`;
+      await runHandler(handlers['budget/set-carryover'], {
+        startMonth: month,
+        category: incomeCategory,
+        flag,
+      });
+      // Only for the months there are at this point
+      for (const laterMonth of ledger.months.filter(m => m >= month)) {
+        ledger.autoHold.set(`${laterMonth}|${incomeCategory}`, flag);
+      }
+      break;
+    }
+    case 11: {
+      if (expense.length < 4) {
+        description = 'nothing';
+        break;
+      }
+      description = `merge ${category} into ${other}`;
+      discrepancies = await mergeCategories(ledger, [category], other, () =>
+        runHandler(handlers['category-delete'], {
+          id: category,
+          transferId: other,
+        }),
+      );
+      break;
+    }
+    case 12: {
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups.filter(g => !g.is_income));
+      const inGroup = group.categories.map(c => c.id);
+      const outside = expense.filter(id => !inGroup.includes(id));
+      if (outside.length < 3 || inGroup.length === 0) {
+        description = 'nothing';
+        break;
+      }
+      const into = random.pick(outside);
+      description = `delete group ${group.id}, merging ${inGroup.join(', ')} into ${into}`;
+      discrepancies = await mergeCategories(ledger, inGroup, into, () =>
+        runHandler(handlers['category-group-delete'], {
+          id: group.id,
+          transferId: into,
+        }),
+      );
+      break;
+    }
+    case 13: {
+      const amount = -random.upTo(30000);
+      description = `spend ${amount} on ${category} in ${month}`;
+      await addTransaction(
+        ledger,
+        month,
+        amount,
+        category,
+        random.pick(['checking', 'business']),
+      );
+      break;
+    }
+    case 14: {
+      description = `copy last month's budget to ${month}`;
+      await runHandler(handlers['budget/copy-previous-month'], { month });
+      const previous = monthUtils.prevMonth(month);
+      for (const id of expense) {
+        ledger.budgeted.set(
+          `${month}|${id}`,
+          getBudgeted(ledger, previous, id),
+        );
+      }
+      break;
+    }
+    case 15: {
+      description = `set budgets to zero in ${month}`;
+      await runHandler(handlers['budget/set-zero'], { month });
+      for (const id of expense) {
+        ledger.budgeted.set(`${month}|${id}`, 0);
+      }
+      break;
+    }
+    case 16:
+    case 17: {
+      // Into any group, the income group included. No figure depends on it.
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups);
+      const id =
+        random.next() < 0.75 ? category : random.pick([...ledger.income]);
+      description = `move ${id} to group ${group.id}`;
+      await runHandler(handlers['category-move'], {
+        id,
+        groupId: group.id,
+        targetId: null,
+      });
+      break;
+    }
+    case 18:
+    case 19: {
+      // Now and then of the other kind than its group, as an import can
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups);
+      const isIncome =
+        random.next() < 0.4 ? group.is_income !== 1 : group.is_income === 1;
+      const id = await runHandler(handlers['category-create'], {
+        name: `new-${random.upTo(1000000000)}`,
+        groupId: group.id,
+        isIncome,
+      });
+      (isIncome ? ledger.income : ledger.expense).add(id);
+      description = `create ${isIncome ? 'income' : 'expense'} category ${id} in ${group.id}`;
+      break;
+    }
+    default: {
+      const lastMonth = ledger.months[ledger.months.length - 1];
+      description = `budget 100 for ${category} in ${lastMonth}, adding months`;
+      await runHandler(handlers['budget/budget-amount'], {
+        month: lastMonth,
+        category,
+        amount: 100,
+      });
+      ledger.budgeted.set(`${lastMonth}|${category}`, 100);
+      await createAllBudgets();
+      ledger.months = getCreatedMonths();
+    }
+  }
+
+  return {
+    description,
+    discrepancies: [...discrepancies, ...(await findDiscrepancies(ledger))],
+  };
+}
+
+beforeEach(global.emptyDatabase());
+
+describe('Envelope budget against an independent ledger', () => {
+  it.each(Array.from({ length: SEEDS }, (_, index) => index + 1))(
+    'balances after every action of random sequence %i',
+    async seed => {
+      const ledger = createLedger();
+      const random = createRandom(seed);
+      await setUpBudget(ledger);
+      expect(await findDiscrepancies(ledger)).toEqual([]);
+      await sheet.waitOnSpreadsheet();
+      const start = snapshotDatabase();
+
+      const actions: string[] = [];
+      for (let step = 0; step < STEPS; step++) {
+        const { description, discrepancies } = await runAction(ledger, random);
+        actions.push(description);
+        expect({ actions, discrepancies }).toEqual({
+          actions,
+          discrepancies: [],
+        });
+      }
+
+      // And once more with the budget built from scratch
+      await sheet.waitOnSpreadsheet();
+      sheet.unloadSpreadsheet();
+      await sheet.loadSpreadsheet(db);
+      await createAllBudgets();
+      ledger.months = getCreatedMonths();
+      expect({
+        actions,
+        discrepancies: await findDiscrepancies(ledger),
+      }).toEqual({ actions, discrepancies: [] });
+
+      // And with everything delivered to the budget as it started out in one
+      // sync, the way a device that was offline receives it
+      await sheet.waitOnSpreadsheet();
+      await replayChangesAsOneSync(start, async () => {
+        sheet.unloadSpreadsheet();
+        await sheet.loadSpreadsheet(db);
+        await createAllBudgets();
+        await sheet.waitOnSpreadsheet();
+      });
+      await createAllBudgets();
+      ledger.months = getCreatedMonths();
+      expect({
+        actions,
+        discrepancies: await findDiscrepancies(ledger),
+      }).toEqual({ actions, discrepancies: [] });
+    },
+  );
+});
