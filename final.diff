diff --git a/packages/loot-core/src/server/budget/category-changes.test.ts b/packages/loot-core/src/server/budget/category-changes.test.ts
new file mode 100644
index 000000000..7c8302924
--- /dev/null
+++ b/packages/loot-core/src/server/budget/category-changes.test.ts
@@ -0,0 +1,218 @@
+import * as db from '#server/db';
+import { runHandler } from '#server/mutators';
+import * as sheet from '#server/sheet';
+import { batchMessages } from '#server/sync';
+
+import { getSheetValue, setBudget } from './actions';
+import { app } from './app';
+import * as budget from './base';
+
+// Totals after categories are reorganised. The spreadsheet is patched as
+// changes come in rather than rebuilt, so these check the patched totals
+// against the amounts that were budgeted and spent.
+
+type BudgetType = 'envelope' | 'tracking';
+
+const MONTH = '2024-01';
+const SHEET = 'budget202401';
+
+async function loadBudget(budgetType: BudgetType) {
+  await sheet.loadSpreadsheet(db);
+  sheet.get().meta().budgetType = budgetType;
+  await budget.createBudget([MONTH]);
+}
+
+// Home:     food  5,000 budgeted, 3,000 spent (personal account)
+//           rent 20,000 budgeted
+// Business: stock 6,000 budgeted, 7,000 spent (business account)
+//           tools 2,000 budgeted, 1,000 spent (business account)
+async function setUpBudget(budgetType: BudgetType) {
+  db.runQuery("INSERT INTO preferences (id, value) VALUES ('budgetType', ?)", [
+    budgetType,
+  ]);
+
+  await db.insertAccount({ id: 'personal', name: 'Personal' });
+  await db.insertAccount({ id: 'business', name: 'Business' });
+
+  await db.insertCategoryGroup({ id: 'income', name: 'Income', is_income: 1 });
+  for (const id of ['salary', 'sales']) {
+    await db.insertCategory({
+      id,
+      name: id,
+      cat_group: 'income',
+      is_income: 1,
+    });
+  }
+
+  await db.insertCategoryGroup({ id: 'home', name: 'Home' });
+  await db.insertCategoryGroup({ id: 'work', name: 'Work' });
+  for (const [id, group] of [
+    ['food', 'home'],
+    ['rent', 'home'],
+    ['stock', 'work'],
+    ['tools', 'work'],
+  ]) {
+    await db.insertCategory({ id, name: id, cat_group: group });
+  }
+
+  for (const [category, amount, account] of [
+    ['salary', 100000, 'personal'],
+    ['food', -3000, 'personal'],
+    ['stock', -7000, 'business'],
+    ['tools', -1000, 'business'],
+  ] as const) {
+    await db.insertTransaction({
+      date: `${MONTH}-15`,
+      amount,
+      account,
+      category,
+    });
+  }
+
+  await loadBudget(budgetType);
+
+  for (const [category, amount] of [
+    ['food', 5000],
+    ['rent', 20000],
+    ['stock', 6000],
+    ['tools', 2000],
+  ] as const) {
+    await setBudget({ category, month: MONTH, amount });
+  }
+  await sheet.waitOnSpreadsheet();
+}
+
+async function value(cell: string) {
+  await sheet.waitOnSpreadsheet();
+  return getSheetValue(SHEET, cell);
+}
+
+beforeEach(global.emptyDatabase());
+
+describe.each(['envelope', 'tracking'] as const)(
+  'Reorganising categories (%s)',
+  budgetType => {
+    beforeEach(() => setUpBudget(budgetType));
+
+    it('stops counting a category that is moved and deleted in the same batch of changes', async () => {
+      // A sync delivers everything another device did in one batch, so the
+      // move to another group and the deletion arrive together
+      await batchMessages(async () => {
+        await db.moveCategory('stock', 'home', null);
+        await runHandler(app.handlers['category-delete'], {
+          id: 'stock',
+          transferId: 'tools',
+        });
+      });
+
+      // Tools takes over what was budgeted and spent on stock, and nothing
+      // is left of it in the group it was in before the move
+      expect(await value('budget-tools')).toBe(8000);
+      expect(await value('group-budget-work')).toBe(8000);
+      expect(await value('group-sum-amount-work')).toBe(-8000);
+      expect(await value('group-budget-home')).toBe(25000);
+      expect(Math.abs(await value('total-budgeted'))).toBe(33000);
+
+      if (budgetType === 'envelope') {
+        expect(await value('to-budget')).toBe(67000);
+      }
+    });
+
+    it('recalculates spending merged from another category when its account goes off budget', async () => {
+      await runHandler(app.handlers['category-delete'], {
+        id: 'food',
+        transferId: 'tools',
+      });
+      expect(await value('sum-amount-tools')).toBe(-4000);
+
+      // The food spending now counted under tools was all in this account
+      await db.updateAccount({ id: 'personal', offbudget: 1 });
+      expect(await value('sum-amount-tools')).toBe(-1000);
+
+      await db.updateAccount({ id: 'personal', offbudget: 0 });
+      expect(await value('sum-amount-tools')).toBe(-4000);
+    });
+
+    it('leaves a category that was merged earlier where it is when its old group is deleted', async () => {
+      await runHandler(app.handlers['category-delete'], {
+        id: 'food',
+        transferId: 'tools',
+      });
+      await runHandler(app.handlers['category-group-delete'], {
+        id: 'home',
+        transferId: 'stock',
+      });
+
+      // Food went to tools with its budget, so its spending stays there
+      // rather than following the rest of the group to stock
+      expect(await value('budget-tools')).toBe(7000);
+      expect(await value('sum-amount-tools')).toBe(-4000);
+      expect(await value('budget-stock')).toBe(26000);
+      expect(await value('sum-amount-stock')).toBe(-7000);
+    });
+
+    it('shows the budgeted amounts of a category restored after the budget was loaded without it', async () => {
+      await db.deleteCategory({ id: 'stock' });
+      await sheet.waitOnSpreadsheet();
+
+      // Deleted categories are skipped when the budget is built from scratch
+      sheet.unloadSpreadsheet();
+      await loadBudget(budgetType);
+      expect(await value('group-budget-work')).toBe(2000);
+
+      // Undoing the deletion, as another device would sync it
+      await db.update('categories', { id: 'stock', tombstone: 0 });
+
+      expect(await value('budget-stock')).toBe(6000);
+      expect(await value('group-budget-work')).toBe(8000);
+    });
+  },
+);
+
+describe('Reorganising categories in a tracking budget', () => {
+  beforeEach(() => setUpBudget('tracking'));
+
+  it('leaves a hidden category out of the totals of the group it is moved to', async () => {
+    await db.update('categories', { id: 'food', hidden: 1 });
+    expect(await value('group-budget-home')).toBe(20000);
+
+    await db.moveCategory('food', 'work', null);
+
+    expect(await value('group-budget-work')).toBe(8000);
+    expect(await value('group-sum-amount-work')).toBe(-8000);
+    expect(await value('total-budgeted')).toBe(28000);
+  });
+
+  it('leaves out a category that is moved and hidden in the same batch of changes', async () => {
+    await batchMessages(async () => {
+      await db.moveCategory('food', 'work', null);
+      await db.update('categories', { id: 'food', hidden: 1 });
+    });
+
+    expect(await value('group-budget-home')).toBe(20000);
+    expect(await value('group-budget-work')).toBe(8000);
+    expect(await value('total-budgeted')).toBe(28000);
+  });
+
+  it('keeps income out of the expense totals when the income group is shown again', async () => {
+    await db.update('category_groups', { id: 'income', hidden: 1 });
+    await db.update('category_groups', { id: 'income', hidden: 0 });
+
+    expect(await value('total-spent')).toBe(-11000);
+    expect(await value('total-budgeted')).toBe(33000);
+  });
+
+  it('moves budgeted income to the category an income category is merged into', async () => {
+    await setBudget({ category: 'salary', month: MONTH, amount: 100000 });
+    await setBudget({ category: 'sales', month: MONTH, amount: 30000 });
+    expect(await value('total-budget-income')).toBe(130000);
+
+    await runHandler(app.handlers['category-delete'], {
+      id: 'sales',
+      transferId: 'salary',
+    });
+
+    expect(await value('budget-salary')).toBe(130000);
+    expect(await value('total-budget-income')).toBe(130000);
+  });
+});
