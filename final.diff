@@ -0,0 +1,72 @@
+import { Timestamp } from '@actual-app/crdt';
+
+import * as sqlite from '#platform/server/sqlite';
+import * as db from '#server/db';
+import { sendMessages } from '#server/sync';
+import type { Message } from '#server/sync';
+
+// Lets a test deliver everything it did to a budget the way another device
+// receives it: as one batch of changes applied to the budget as it was
+// before, instead of one change at a time.
+
+const SYNCED_TABLES = [
+  'category_groups',
+  'categories',
+  'category_mapping',
+  'zero_budgets',
+  'reflect_budgets',
+  'zero_budget_months',
+  'accounts',
+  'transactions',
+];
+
+type Row = Record<string, string | number | null>;
+type Rows = Map<string, Map<string, Row>>;
+
+export type DatabaseSnapshot = { image: Buffer; rows: Rows };
+
+function readRows(): Rows {
+  const rows: Rows = new Map();
+  for (const table of SYNCED_TABLES) {
+    const tableRows = db.runQuery<Row>(`SELECT * FROM ${table}`, [], true);
+    rows.set(table, new Map(tableRows.map(row => [String(row.id), row])));
+  }
+  return rows;
+}
+
+export function snapshotDatabase(): DatabaseSnapshot {
+  // The test database is an in-memory better-sqlite3 one
+  const database = db.getDatabase() as unknown as { serialize: () => Buffer };
+  return { image: database.serialize(), rows: readRows() };
+}
+
+// Goes back to the snapshot, lets the caller load the budget from it, and
+// then applies every change made since in a single batch
+export async function replayChangesAsOneSync(
+  snapshot: DatabaseSnapshot,
+  loadBudget: () => Promise<void>,
+): Promise<void> {
+  const changedRows = readRows();
+
+  db.setDatabase(await sqlite.openDatabase(snapshot.image));
+  await loadBudget();
+
+  const messages: Message[] = [];
+  for (const [table, rows] of changedRows) {
+    for (const [id, row] of rows) {
+      const before = snapshot.rows.get(table)?.get(id);
+      for (const [column, value] of Object.entries(row)) {
+        const hasChanged = before ? before[column] !== value : value != null;
+        if (column !== 'id' && hasChanged) {
+          const timestamp = Timestamp.send();
+          if (!timestamp) {
+            throw new Error('The clock has to be loaded to replay changes');
+          }
+          messages.push({ dataset: table, row: id, column, value, timestamp });
+        }
+      }
+    }
+  }
+
+  await sendMessages(messages);
+}
