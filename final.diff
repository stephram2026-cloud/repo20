+
+// Whether a category rolls over its overspending in a month nothing has been
+// saved for yet. Turning it on applies to every later month, but it is only
+// saved for the months that exist at that point, so months added afterwards
+// carry on from the month before them. Holding income automatically is
+// different: it only ever covers the months it was turned on for.
+export function getInheritedCarryover(cat, prevSheetName): boolean {
+  if (cat.is_income) {
+    return false;
+  }
+  return (
+    sheet.get().getCellValueLoose(prevSheetName, `carryover-${cat.id}`) === true
+  );
+}
+
+// A category is income or an expense by its own setting, wherever it is
+// filed. The screens only let it be filed in a group of its own kind, but the
+// API, an import or a sync can leave an expense category in the income group
+// or the other way round. Such a category is left out of the totals of the
+// group, which only add up categories of the group's kind, and goes straight
+// into the month's totals for its own kind instead. Otherwise spending in it
+// would be taken off the income.
+export function isFiledUnderOwnKind(cat, group): boolean {
+  return Boolean(cat.is_income) === Boolean(group.is_income);
+}
+
+// The categories of the given kind that are filed in a group of the other
+// kind
+export function getMisfiledCategories(
+  groups,
+  { isIncome }: { isIncome: boolean },
+) {
+  return groups
+    .filter(group => Boolean(group.is_income) !== isIncome)
+    .flatMap(group =>
+      (group.categories ?? []).filter(
+        cat => Boolean(cat.is_income) === isIncome,
+      ),
+    );
+}
+
+export function getIncomeGroupIds(): Set<string> {
+  const rows = db.runQuery<Pick<db.DbCategoryGroup, 'id'>>(
+    'SELECT id FROM category_groups WHERE is_income = 1',
+    [],
+    true,
+  );
+  return new Set(rows.map(row => row.id));
+}
