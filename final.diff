+
+import { app } from './app';
+import { createAllBudgets } from './base';
+
+// Runs random sequences of actions on a tracking budget and checks every
+// figure it shows against an independent ledger after each one.
+//
+// The ledger is told what each action is meant to do and works the months out
+// from the rules of a tracking budget alone, never from the budget
+// recalculating itself:
+//
+// - a category's balance is what was budgeted less what was spent (for
+//   income: what was budgeted less what was received). Nothing carries into
+//   the next month unless the category rolls over, and then its whole balance
+//   does
+// - a category is income or an expense by its own setting, wherever it is
+//   filed: the API or an import can leave an expense category in the income
+//   group, and what is spent in it is still spending, not negative income
+// - group totals add up the categories of the group that aren't hidden and
+//   are of the group's kind, and the month's totals add up the expense
+//   groups that aren't hidden plus any expense category filed under income
+// - projected savings are budgeted income less budgeted expenses, and what
+//   was saved is the income received less what was spent
+
+const handlers = app.handlers;
+
+const INCOME_GROUP = 'income';
+const FIRST_MONTHS = ['2016-10', '2016-11', '2016-12', '2017-01'];
+const ACTION_MONTHS = [...FIRST_MONTHS, '2017-02', '2017-03'];
+const SEEDS = Number(process.env.LEDGER_SEEDS || 40);
+const STEPS = Number(process.env.LEDGER_STEPS || 12);
+
+type Transaction = {
+  id: string;
+  month: string;
+  amount: number;
+  category: string;
+  account: string;
+};
+
+type Category = { group: string; isIncome: boolean; isHidden: boolean };
+
+type Ledger = {
+  months: string[];
+  categories: Map<string, Category>;
+  hiddenGroups: Set<string>;
+  onBudget: Map<string, boolean>;
+  transactions: Transaction[];
+  // `${month}|${category}` to the amount budgeted
+  budgeted: Map<string, number>;
+  // Rolling over is turned on or off from a month on
+  rollover: Map<string, Array<[string, boolean]>>;
+};
+
+function createLedger(): Ledger {
+  return {
+    months: [],
+    categories: new Map(),
+    hiddenGroups: new Set(),
+    onBudget: new Map(),
+    transactions: [],
+    budgeted: new Map(),
+    rollover: new Map(),
+  };
+}
+
+function getBudgeted(ledger: Ledger, month: string, category: string) {
+  return ledger.budgeted.get(`${month}|${category}`) ?? 0;
+}
+
+function getActivity(ledger: Ledger, month: string, category: string) {
+  return ledger.transactions
+    .filter(
+      t =>
+        t.month === month &&
+        t.category === category &&
+        ledger.onBudget.get(t.account),
+    )
+    .reduce((total, t) => total + t.amount, 0);
+}
+
+function rollsOver(ledger: Ledger, month: string, category: string) {
+  let isOn = false;
+  for (const [start, flag] of ledger.rollover.get(category) ?? []) {
+    if (month >= start) {
+      isOn = flag;
+    }
+  }
+  return isOn;
+}
+
+type Totals = { budgeted: number; activity: number; balance: number };
+
+type MonthFigures = {
+  categories: Map<string, Totals>;
+  groups: Map<string, Totals>;
+  budgetedExpenses: number;
+  spent: number;
+  expenseBalance: number;
+  budgetedIncome: number;
+  received: number;
+};
+
+function computeMonths(ledger: Ledger): Map<string, MonthFigures> {
+  const months = new Map<string, MonthFigures>();
+  const previousBalance = new Map<string, number>();
+  let previousMonth: string | null = null;
+
+  for (const month of ledger.months) {
+    const figures: MonthFigures = {
+      categories: new Map(),
+      groups: new Map(),
+      budgetedExpenses: 0,
+      spent: 0,
+      expenseBalance: 0,
+      budgetedIncome: 0,
+      received: 0,
+    };
+
+    for (const [id, category] of ledger.categories) {
+      const budgeted = getBudgeted(ledger, month, id);
+      const activity = getActivity(ledger, month, id);
+      const carried =
+        previousMonth != null &&
+        !category.isIncome &&
+        rollsOver(ledger, previousMonth, id)
+          ? (previousBalance.get(id) ?? 0)
+          : 0;
+      const balance = category.isIncome
+        ? budgeted - activity
+        : budgeted + activity + carried;
+      figures.categories.set(id, { budgeted, activity, balance });
+      previousBalance.set(id, balance);
+
+      if (category.isHidden) {
+        continue;
+      }
+
+      const isFiledUnderOwnKind =
+        category.isIncome === (category.group === INCOME_GROUP);
+      if (isFiledUnderOwnKind) {
+        const group = figures.groups.get(category.group) ?? {
+          budgeted: 0,
+          activity: 0,
+          balance: 0,
+        };
+        group.budgeted += budgeted;
+        group.activity += activity;
+        group.balance += balance;
+        figures.groups.set(category.group, group);
+      }
+
+      if (category.isIncome) {
+        figures.budgetedIncome += budgeted;
+        figures.received += activity;
+      } else if (
+        !isFiledUnderOwnKind ||
+        !ledger.hiddenGroups.has(category.group)
+      ) {
+        figures.budgetedExpenses += budgeted;
+        figures.spent += activity;
+        figures.expenseBalance += balance;
+      }
+    }
+
+    months.set(month, figures);
+    previousMonth = month;
+  }
+
+  return months;
+}
+
+function createRandom(seed: number) {
+  let state = seed >>> 0;
+  const next = () => {
+    state = (state * 1664525 + 1013904223) >>> 0;
+    return state / 4294967296;
+  };
+  return {
+    next,
+    upTo: (max: number) => Math.floor(next() * max),
+    pick: <T>(items: T[]): T => items[Math.floor(next() * items.length)],
+  };
+}
+
+function getCreatedMonths() {
+  return [...sheet.get().meta().createdMonths].sort();
+}
+
+async function addTransaction(
+  ledger: Ledger,
+  month: string,
+  amount: number,
+  category: string,
+  account: string,
+) {
+  const id = `transaction-${ledger.transactions.length}`;
+  await db.insertTransaction({
+    id,
+    date: `${month}-15`,
+    amount,
+    category,
+    account,
+  });
+  ledger.transactions.push({ id, month, amount, category, account });
+}
+
+async function setBudgeted(
+  ledger: Ledger,
+  month: string,
+  category: string,
+  amount: number,
+) {
+  await runHandler(handlers['budget/budget-amount'], {
+    month,
+    category,
+    amount,
+  });
+  ledger.budgeted.set(`${month}|${category}`, amount);
+}
+
+async function setUpBudget(ledger: Ledger) {
+  db.runQuery(
+    "INSERT INTO preferences (id, value) VALUES ('budgetType', 'tracking')",
+  );
+  await sheet.loadSpreadsheet(db);
+  sheet.get().meta().budgetType = 'tracking';
+
+  await db.insertCategoryGroup({
+    id: INCOME_GROUP,
+    name: 'Income',
+    is_income: 1,
+  });
+  for (const id of ['sales', 'interest', 'grants']) {
+    await db.insertCategory({
+      id,
+      name: id,
+      cat_group: INCOME_GROUP,
+      is_income: 1,
+    });
+    ledger.categories.set(id, {
+      group: INCOME_GROUP,
+      isIncome: true,
+      isHidden: false,
+    });
+  }
+
+  for (const [group, categories] of [
+    ['premises', ['rent', 'power', 'repairs']],
+    ['trading', ['stock', 'tools']],
+    ['other', ['fees', 'gifts']],
+  ] as const) {
+    await db.insertCategoryGroup({ id: group, name: group });
+    for (const id of categories) {
+      await db.insertCategory({ id, name: id, cat_group: group });
+      ledger.categories.set(id, { group, isIncome: false, isHidden: false });
+    }
+  }
+
+  for (const [id, offbudget] of [
+    ['current', 0],
+    ['card', 0],
+    ['loan', 1],
+  ] as const) {
+    await db.insertAccount({ id, name: id, offbudget });
+    ledger.onBudget.set(id, offbudget === 0);
+  }
+
+  for (const month of FIRST_MONTHS) {
+    for (const [amount, category, account] of [
+      [500000, 'sales', 'current'],
+      [1200, 'interest', 'current'],
+      [-100000, 'rent', 'current'],
+      [-14000, 'power', 'current'],
+      [-7000, 'repairs', 'card'],
+      [-160000, 'stock', 'card'],
+      [-9000, 'tools', 'card'],
+      [-1500, 'fees', 'current'],
+      [-2500, 'gifts', 'loan'],
+    ] as const) {
+      await addTransaction(ledger, month, amount, category, account);
+    }
+  }
+
+  await createAllBudgets();
+  ledger.months = getCreatedMonths();
+
+  for (const month of FIRST_MONTHS) {
+    for (const [category, amount] of [
+      ['sales', 480000],
+      ['interest', 1000],
+      ['grants', 20000],
+      ['rent', 100000],
+      ['power', 12000],
+      ['repairs', 10000],
+      ['stock', 150000],
+      ['tools', 12000],
+      ['fees', 1000],
+      ['gifts', 3000],
+    ] as const) {
+      await setBudgeted(ledger, month, category, amount);
+    }
+  }
+}
+
+function readCell(month: string, name: string) {
+  const cell = sheet
+    .get()
+    .getCellValueLoose(monthUtils.sheetForMonth(month), name);
+  return typeof cell === 'number' ? cell : 0;
+}
+
+// Every way the budget disagrees with the ledger
+async function findDiscrepancies(ledger: Ledger): Promise<string[]> {
+  await sheet.waitOnSpreadsheet();
+  const expected = computeMonths(ledger);
+  const discrepancies: string[] = [];
+  const groups = await db.getCategoriesGrouped();
+
+  for (const month of ledger.months) {
+    const figures = expected.get(month);
+    if (!figures) {
+      continue;
+    }
+
+    const check = (label: string, actual: number, shouldBe: number) => {
+      if (actual !== shouldBe) {
+        discrepancies.push(
+          `${month} ${label}: ${actual}, should be ${shouldBe}`,
+        );
+      }
+    };
+
+    for (const [id, totals] of figures.categories) {
+      check(`${id} budgeted`, readCell(month, `budget-${id}`), totals.budgeted);
+      check(
+        `${id} activity`,
+        readCell(month, `sum-amount-${id}`),
+        totals.activity,
+      );
+      check(`${id} balance`, readCell(month, `leftover-${id}`), totals.balance);
+    }
+
+    for (const group of groups) {
+      const totals = figures.groups.get(group.id) ?? {
+        budgeted: 0,
+        activity: 0,
+        balance: 0,
+      };
+      check(
+        `${group.id} group budgeted`,
+        readCell(month, `group-budget-${group.id}`),
+        totals.budgeted,
+      );
+      check(
+        `${group.id} group activity`,
+        readCell(month, `group-sum-amount-${group.id}`),
+        totals.activity,
+      );
+      check(
+        `${group.id} group balance`,
+        readCell(month, `group-leftover-${group.id}`),
+        totals.balance,
+      );
+    }
+
+    check(
+      'budgeted expenses',
+      readCell(month, 'total-budgeted'),
+      figures.budgetedExpenses,
+    );
+    check('spent', readCell(month, 'total-spent'), figures.spent);
+    check(
+      'expense balance',
+      readCell(month, 'total-leftover'),
+      figures.expenseBalance,
+    );
+    check(
+      'budgeted income',
+      readCell(month, 'total-budget-income'),
+      figures.budgetedIncome,
+    );
+    check('received', readCell(month, 'total-income'), figures.received);
+    check(
+      'projected savings',
+      readCell(month, 'total-saved'),
+      figures.budgetedIncome - figures.budgetedExpenses,
+    );
+    check(
+      'saved',
+      readCell(month, 'real-saved'),
+      figures.received + figures.spent,
+    );
+  }
+
+  return discrepancies;
+}
+
+// Merging adds what was budgeted for the merged categories to the remaining
+// one, exactly as it was entered, and moves their transactions to it
+function mergeInLedger(ledger: Ledger, merged: string[], into: string) {
+  for (const month of ledger.months) {
+    const total = [...merged, into].reduce(
+      (sum, category) => sum + getBudgeted(ledger, month, category),
+      0,
+    );
+    ledger.budgeted.set(`${month}|${into}`, total);
+  }
+  for (const transaction of ledger.transactions) {
+    if (merged.includes(transaction.category)) {
+      transaction.category = into;
+    }
+  }
+  merged.forEach(category => ledger.categories.delete(category));
+}
+
+async function runAction(
+  ledger: Ledger,
+  random: ReturnType<typeof createRandom>,
+): Promise<string> {
+  const ids = (isIncome: boolean) =>
+    [...ledger.categories]
+      .filter(([, category]) => category.isIncome === isIncome)
+      .map(([id]) => id);
+  const expense = ids(false);
+  const income = ids(true);
+  const month =
+    random.next() < 0.15
+      ? random.pick(ledger.months.slice(-4))
+      : random.pick(ACTION_MONTHS);
+  const category = random.pick(expense);
+  const other = random.pick(expense.filter(id => id !== category));
+  const incomeCategory = random.pick(income);
+
+  switch (random.upTo(24)) {
+    case 0: {
+      const amount = random.upTo(60000);
+      await setBudgeted(ledger, month, category, amount);
+      return `budget ${amount} for ${category} in ${month}`;
+    }
+    case 1: {
+      const amount = random.upTo(600000);
+      await setBudgeted(ledger, month, incomeCategory, amount);
+      return `budget ${amount} for ${incomeCategory} in ${month}`;
+    }
+    case 2:
+    case 3: {
+      const flag = random.next() < 0.65;
+      await runHandler(handlers['budget/set-carryover'], {
+        startMonth: month,
+        category,
+        flag,
+      });
+      ledger.rollover.set(category, [
+        ...(ledger.rollover.get(category) ?? []),
+        [month, flag],
+      ]);
+      return `roll over ${category} from ${month}: ${flag}`;
+    }
+    case 4: {
+      if (expense.length < 4) {
+        return 'nothing';
+      }
+      await runHandler(handlers['category-delete'], {
+        id: category,
+        transferId: other,
+      });
+      mergeInLedger(ledger, [category], other);
+      return `merge ${category} into ${other}`;
+    }
+    case 5: {
+      if (income.length < 2) {
+        return 'nothing';
+      }
+      const into = random.pick(income.filter(id => id !== incomeCategory));
+      await runHandler(handlers['category-delete'], {
+        id: incomeCategory,
+        transferId: into,
+      });
+      mergeInLedger(ledger, [incomeCategory], into);
+      return `merge ${incomeCategory} into ${into}`;
+    }
+    case 6: {
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups.filter(g => !g.is_income));
+      const inGroup = group.categories.map(c => c.id);
+      const outside = expense.filter(id => !inGroup.includes(id));
+      if (outside.length < 3 || inGroup.length === 0) {
+        return 'nothing';
+      }
+      const into = random.pick(outside);
+      await runHandler(handlers['category-group-delete'], {
+        id: group.id,
+        transferId: into,
+      });
+      mergeInLedger(ledger, inGroup, into);
+      return `delete group ${group.id}, merging ${inGroup.join(', ')} into ${into}`;
+    }
+    case 7:
+    case 22:
+    case 23: {
+      // Into any group, the income group included, and income categories too
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups);
+      const id = random.next() < 0.75 ? category : incomeCategory;
+      await runHandler(handlers['category-move'], {
+        id,
+        groupId: group.id,
+        targetId: null,
+      });
+      const moved = ledger.categories.get(id);
+      if (moved) {
+        moved.group = group.id;
+      }
+      return `move ${id} to group ${group.id}`;
+    }
+    case 8:
+    case 9: {
+      const id = random.next() < 0.75 ? category : incomeCategory;
+      const changed = ledger.categories.get(id);
+      if (!changed) {
+        return 'nothing';
+      }
+      changed.isHidden = !changed.isHidden;
+      await db.update('categories', {
+        id,
+        hidden: changed.isHidden ? 1 : 0,
+      });
+      return `${changed.isHidden ? 'hide' : 'show'} ${id}`;
+    }
+    case 10: {
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups);
+      const isHidden = !group.hidden;
+      await db.update('category_groups', {
+        id: group.id,
+        hidden: isHidden ? 1 : 0,
+      });
+      if (isHidden) {
+        ledger.hiddenGroups.add(group.id);
+      } else {
+        ledger.hiddenGroups.delete(group.id);
+      }
+      return `${isHidden ? 'hide' : 'show'} group ${group.id}`;
+    }
+    case 11: {
+      const amount = -random.upTo(30000);
+      await addTransaction(
+        ledger,
+        month,
+        amount,
+        category,
+        random.pick(['current', 'card']),
+      );
+      return `spend ${amount} on ${category} in ${month}`;
+    }
+    case 12: {
+      const amount = random.upTo(90000);
+      await addTransaction(ledger, month, amount, incomeCategory, 'current');
+      return `receive ${amount} as ${incomeCategory} in ${month}`;
+    }
+    case 13: {
+      const transaction = random.pick(ledger.transactions);
+      const amount = random.upTo(40000) - 20000;
+      await db.updateTransaction({ id: transaction.id, amount });
+      transaction.amount = amount;
+      return `change ${transaction.id} to ${amount}`;
+    }
+    case 14: {
+      const account = random.pick([...ledger.onBudget.keys()]);
+      const isOnBudget = !ledger.onBudget.get(account);
+      await db.updateAccount({ id: account, offbudget: isOnBudget ? 0 : 1 });
+      ledger.onBudget.set(account, isOnBudget);
+      return `account ${account} on budget: ${isOnBudget}`;
+    }
+    case 15: {
+      await runHandler(handlers['budget/copy-previous-month'], { month });
+      // Every category that isn't hidden, itself or through its group, gets
+      // what was budgeted the month before
+      const previous = monthUtils.prevMonth(month);
+      for (const [id, copied] of ledger.categories) {
+        if (!copied.isHidden && !ledger.hiddenGroups.has(copied.group)) {
+          ledger.budgeted.set(
+            `${month}|${id}`,
+            getBudgeted(ledger, previous, id),
+          );
+        }
+      }
+      return `copy last month's budget to ${month}`;
+    }
+    case 16: {
+      await runHandler(handlers['budget/set-zero'], { month });
+      for (const id of ledger.categories.keys()) {
+        ledger.budgeted.set(`${month}|${id}`, 0);
+      }
+      return `set budgets to zero in ${month}`;
+    }
+    case 17: {
+      await runHandler(handlers['budget/copy-single-month'], {
+        month,
+        category,
+      });
+      ledger.budgeted.set(
+        `${month}|${category}`,
+        getBudgeted(ledger, monthUtils.prevMonth(month), category),
+      );
+      return `copy last month's budget of ${category} to ${month}`;
+    }
+    case 18: {
+      await runHandler(handlers['budget/copy-until-year-end'], {
+        month,
+        category,
+      });
+      const yearEnd = `${month.slice(0, 4)}-12`;
+      for (const later of ledger.months) {
+        if (later > month && later <= yearEnd) {
+          ledger.budgeted.set(
+            `${later}|${category}`,
+            getBudgeted(ledger, month, category),
+          );
+        }
+      }
+      return `copy the budget of ${category} from ${month} until year end`;
+    }
+    case 19:
+    case 20: {
+      const groups = await db.getCategoriesGrouped();
+      const group = random.pick(groups);
+      const isHidden = random.next() < 0.3;
+      const name = `new-${random.upTo(1000000000)}`;
+      // Now and then of the other kind than its group, as an import can
+      const isIncome =
+        random.next() < 0.3 ? group.is_income !== 1 : group.is_income === 1;
+      const id = await runHandler(handlers['category-create'], {
+        name,
+        groupId: group.id,
+        isIncome,
+        hidden: isHidden,
+      });
+      ledger.categories.set(id, { group: group.id, isIncome, isHidden });
+      return `create ${isHidden ? 'hidden ' : ''}${isIncome ? 'income' : 'expense'} category ${id} in ${group.id}`;
+    }
+    default: {
+      const lastMonth = ledger.months[ledger.months.length - 1];
+      await setBudgeted(ledger, lastMonth, category, 100);
+      await createAllBudgets();
+      ledger.months = getCreatedMonths();
+      return `budget 100 for ${category} in ${lastMonth}, adding months`;
+    }
+  }
+}
+
+beforeEach(global.emptyDatabase());
+
+describe('Tracking budget against an independent ledger', () => {
+  it.each(Array.from({ length: SEEDS }, (_, index) => index + 1))(
+    'agrees after every action of random sequence %i',
+    async seed => {
+      const ledger = createLedger();
+      const random = createRandom(seed);
+      await setUpBudget(ledger);
+      expect(await findDiscrepancies(ledger)).toEqual([]);
+      await sheet.waitOnSpreadsheet();
+      const start = snapshotDatabase();
+
+      const actions: string[] = [];
+      for (let step = 0; step < STEPS; step++) {
+        actions.push(await runAction(ledger, random));
+        expect({
+          actions,
+          discrepancies: await findDiscrepancies(ledger),
+        }).toEqual({ actions, discrepancies: [] });
+      }
+
+      // And once more with the budget built from scratch
+      await sheet.waitOnSpreadsheet();
+      sheet.unloadSpreadsheet();
+      await sheet.loadSpreadsheet(db);
+      sheet.get().meta().budgetType = 'tracking';
+      await createAllBudgets();
+      ledger.months = getCreatedMonths();
+      expect({
+        actions,
+        discrepancies: await findDiscrepancies(ledger),
+      }).toEqual({ actions, discrepancies: [] });
+
+      // And with everything delivered to the budget as it started out in one
+      // sync, the way a device that was offline receives it
+      await sheet.waitOnSpreadsheet();
+      await replayChangesAsOneSync(start, async () => {
+        sheet.unloadSpreadsheet();
+        await sheet.loadSpreadsheet(db);
+        sheet.get().meta().budgetType = 'tracking';
+        await createAllBudgets();
+        await sheet.waitOnSpreadsheet();
+      });
+      await createAllBudgets();
+      ledger.months = getCreatedMonths();
+      expect({
+        actions,
+        discrepancies: await findDiscrepancies(ledger),
+      }).toEqual({ actions, discrepancies: [] });
+    },
+  );
+});
